# This repository tracks the Mediline application layer, not WordPress core,
# third-party distributions, local runtime state, credentials, or generated data.
/*
!/.gitignore
!/.gitattributes
!/.htaccess
!/wp-content/

/wp-content/*
!/wp-content/themes/
!/wp-content/plugins/

/wp-content/themes/*
!/wp-content/themes/mediline-partners/

/wp-content/plugins/*
!/wp-content/plugins/mediline-catalog-core/
!/wp-content/plugins/mediline-store-core/

# Never commit host-specific secrets or customer/generated artifacts.
/wp-config.php
/wp-content/uploads/
/wp-content/cache/
/wp-content/upgrade/
/wp-content/debug.log
/wp-content/mediline-private-packages/
/wp-content/mediline-private-installations/
/.mediline-test-runtime/
/*.zip
/*.sql
/*.log

# Editor and OS noise.
.DS_Store
Thumbs.db
*.tmp
*.bak
